# Dirección HTTP del servicio de identidad (por defecto :9090)
FLOWPAY_SSO_ADDR=:9090

# Misma base que el API (usuarios y company_users)
FLOWPAY_SSO_DSN=flowpay:flowpay@tcp(127.0.0.1:3306)/flowpay?parseTime=true&loc=Local&clientFoundRows=true

# JWT HS256. Mínimo 16 caracteres. El mismo valor en SSO, backend y payments.
# En producción el proceso no arranca si falta. El access token es corto.
# Backend y payments rechazan un jti que esté en revoked_access_tokens. La sesión vive en la cookie de refresh.
FLOWPAY_JWT_SECRET=
FLOWPAY_ACCESS_TTL=15m
FLOWPAY_REFRESH_IDLE=2h
FLOWPAY_REFRESH_ABSOLUTE=12h

# production cierra POST /auth/bootstrap/platform-admin si no hay secreto. En local puede quedar vacío.
FLOWPAY_ENV=
FLOWPAY_BOOTSTRAP_SECRET=

# Cifra el secreto TOTP. En producción es obligatoria (mín. 32 caracteres) y el proceso no arranca si falta.
# En local, si queda vacía, se deriva del JWT.
FLOWPAY_DATA_KEY=

# Aviso al super admin cuando alguien pide una cuenta. Si el correo extra va vacío, se avisa a los platform_admin activos.
FLOWPAY_SIGNUP_NOTIFY_EMAIL=
FLOWPAY_SMTP_HOST=
# 587 es STARTTLS. 465 es TLS directo; úsalo si 587 no conecta desde el servidor.
FLOWPAY_SMTP_PORT=587
FLOWPAY_SMTP_USER=
FLOWPAY_SMTP_PASSWORD=
FLOWPAY_SMTP_FROM=
