# Dirección HTTP del servicio de identidad (por defecto :9090)
FLOWPAY_SSO_ADDR=:9090

# Misma base que el API (usuarios y company_users)
FLOWPAY_SSO_DSN=flowpay:flowpay@tcp(127.0.0.1:3306)/flowpay?parseTime=true&loc=Local&clientFoundRows=true

# JWT HS256 — debe coincidir con FLOWPAY_JWT_SECRET del backend (mín. 16 caracteres)
FLOWPAY_JWT_SECRET=cambia-esto-mismo-en-sso-y-backend-32chars
FLOWPAY_JWT_TTL=24h
